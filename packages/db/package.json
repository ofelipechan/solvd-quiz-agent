{
  "name": "@quiz-agent/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "@types/pg": "^8.11.10",
    "@types/bcrypt": "^5.0.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "typescript": "^5.6.3"
  }
}
