# Postgres connection string used by packages/db (drizzle-kit and app runtime)
DATABASE_URL=postgres://quiz_agent:quiz_agent@localhost:5432/quiz_agent

# Secret used to sign/verify auth JWTs. Use a long random value in real deployments.
JWT_SECRET=replace-with-a-long-random-secret

# OpenRouter API key used by the quiz generation strategy.
OPENROUTER_API_KEY=sk-or-placeholder
