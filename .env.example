# Postgres connection string used by apps/api (drizzle-kit and app runtime)
DATABASE_URL=postgres://postgres_local:postgres_local@localhost:5432/postgres_local

# Secret used to sign/verify auth JWTs. Use a long random value in real deployments.
JWT_SECRET=replace-with-a-long-random-secret

# OpenRouter API key used by the quiz generation strategy.
OPENROUTER_API_KEY=sk-or-placeholder

# Langfuse LLM observability (apps/api). Keys: Langfuse project -> Settings -> API Keys.
# Base URL: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) or a self-hosted URL.
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: label traces per deployment (defaults to NODE_ENV, then "development").
LANGFUSE_TRACING_ENVIRONMENT=development
